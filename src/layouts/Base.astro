---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { locales, localesInfo, localePath, stripLocale, defaultLang, type Lang } from '../i18n/ui';

interface Props {
  title: string;
  description: string;
  lang?: Lang;
  /** 404 and other non-indexable pages: no canonical, and tell crawlers to stay out. */
  noindex?: boolean;
}

const { title, description, lang = defaultLang, noindex = false } = Astro.props;
const site = 'https://glgl.me';
const info = localesInfo[lang];

const currentPath = Astro.url.pathname.replace(/index\.html$/, '');
const canonical = new URL(currentPath, site).href;

// every page advertises its translations
const barePath = stripLocale(currentPath) || '/';
const alternates = locales.map((locale) => ({
  hreflang: localesInfo[locale].htmlLang,
  href: new URL(localePath(locale, barePath), site).href
}));
---

<!doctype html>
<html lang={info.htmlLang} dir={info.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Ahmed Abdelgelel" />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    {alternates.map((alternate) => (
      <link rel="alternate" hreflang={alternate.hreflang} href={alternate.href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={new URL(barePath, site).href} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="transparent" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={site + '/assets/img/og.png'} />
    <meta property="og:locale" content={info.htmlLang} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={site + '/assets/img/og.png'} />

    <link rel="icon" type="image/png" sizes="64x64" href="/assets/img/favicon-64.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/img/favicon-180.png" />
    <link rel="preload" href="/assets/fonts/geist-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/assets/fonts/geistmono-latin.woff2" as="font" type="font/woff2" crossorigin />

    <script is:inline>
      // apply a saved theme before the first paint, so nothing flashes
      try {
        var saved = localStorage.getItem('theme');
        if (saved === 'light' || saved === 'dark') document.documentElement.dataset.theme = saved;
      } catch (error) {}
    </script>

    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Person',
      name: 'Ahmed Abdelgelel',
      jobTitle: 'Backend engineer',
      url: site,
      image: site + '/assets/img/ahmed.jpg',
      email: 'mailto:ahmed4bdelgelel@gmail.com',
      address: { '@type': 'PostalAddress', addressLocality: 'Cairo', addressCountry: 'EG' },
      sameAs: ['https://github.com/AhmedAbdelgelel', 'https://www.linkedin.com/in/ahmed-abdelgelel-6aa523283/']
    })} />
  </head>
  <body>
    <main class="site">
      <Header lang={lang} />
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
