---
/**
 * An interactive architecture walk-through.
 *
 * Renders every step as a real article, so with JavaScript off the section is a numbered
 * explanation. With JavaScript on it becomes a stepper: the track selects a step and the
 * panels show one at a time. Arrow keys, Home and End work when the track has focus.
 */
import type { Flow } from '../data/flows';

interface Props {
  id: string;
  flow: Flow;
}

const { id, flow } = Astro.props;
const steps = flow.steps;
---

<section class="flow" data-flow aria-labelledby={id + '-title'}>
  <header class="flow__head">
    <h2 id={id + '-title'}>{flow.title}</h2>
    <p class="flow__hint">{flow.hint}</p>
  </header>

  <ol class="flow__track">
    {steps.map((step, index) => (
      <li>
        <button
          type="button"
          class="flow__node"
          data-step={index}
          aria-controls={id + '-panel-' + index}
        >
          <span class="flow__num">{String(index + 1).padStart(2, '0')}</span>
          <span class="flow__label">{step.label}</span>
        </button>
      </li>
    ))}
  </ol>

  <div class="flow__panels">
    {steps.map((step, index) => (
      <article class="flow__panel" id={id + '-panel-' + index} data-panel={index}>
        <h3>{step.title}</h3>
        <p>{step.body}</p>
        {step.notes && (
          <ul class="flow__notes">
            {step.notes.map((note) => <li>{note}</li>)}
          </ul>
        )}
      </article>
    ))}
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-flow]').forEach((section) => {
    const nodes = Array.from(section.querySelectorAll<HTMLButtonElement>('.flow__node'));
    const panels = Array.from(section.querySelectorAll<HTMLElement>('.flow__panel'));
    if (nodes.length === 0 || nodes.length !== panels.length) return;

    section.classList.add('is-interactive');
    let current = 0;

    const show = (next: number): void => {
      current = (next + nodes.length) % nodes.length;
      nodes.forEach((node, index) => {
        node.setAttribute('aria-current', index === current ? 'step' : 'false');
        node.tabIndex = index === current ? 0 : -1;
      });
      panels.forEach((panel, index) => {
        panel.classList.toggle('is-active', index === current);
      });
    };

    nodes.forEach((node, index) => {
      node.addEventListener('click', () => show(index));
    });

    section.addEventListener('keydown', (event) => {
      const key = (event as KeyboardEvent).key;
      if (key === 'ArrowRight' || key === 'ArrowDown') {
        event.preventDefault();
        show(current + 1);
        nodes[current].focus();
      } else if (key === 'ArrowLeft' || key === 'ArrowUp') {
        event.preventDefault();
        show(current - 1);
        nodes[current].focus();
      } else if (key === 'Home') {
        event.preventDefault();
        show(0);
        nodes[0].focus();
      } else if (key === 'End') {
        event.preventDefault();
        show(nodes.length - 1);
        nodes[nodes.length - 1].focus();
      }
    });

    show(0);
  });
</script>