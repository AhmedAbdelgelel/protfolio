---
/**
 * The cache's internals, drawn in the site's own style.
 *
 * A hash map on the left pointing into a doubly linked list on the right: buckets resolve a key
 * in O(1), the list keeps recency, and the tail is the next entry to evict. Hovering links the
 * two sides so the mapping is obvious.
 */
import type { Lang } from '../i18n/ui';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const copy =
  lang === 'ar'
    ? { title: 'كيف يُخزَّن المفتاح', hint: 'مرّر على خانة أو عقدة' }
    : { title: 'How a key is stored', hint: 'hover a bucket or a node' };

const buckets = [
  { id: 'b0', target: 'a', key: 'key:a', value: '"a"', ttl: 'ttl 4s' },
  { id: 'b1', target: 'c', key: 'key:c', value: '"c"', ttl: 'no ttl' },
  { id: 'b2', target: 'b', key: 'key:b', value: '"b"', ttl: 'ttl 12s' },
  { id: 'b3', target: null, key: 'empty', value: '', ttl: '' }
];

const nodes = [
  { id: 'a', x: 300, label: '"a"', ttl: 'ttl 4s', bucket: 'b0' },
  { id: 'c', x: 470, label: '"c"', ttl: 'no ttl', bucket: 'b1' },
  { id: 'b', x: 640, label: '"b"', ttl: 'ttl 12s', bucket: 'b2' }
];
---

<section class="cache-map" data-cache-map data-accent="amber" aria-labelledby="cache-map-title">
  <header class="cache-map__head">
    <h3 id="cache-map-title">{copy.title}</h3>
    <p class="cache-map__hint">{copy.hint}</p>
  </header>

  <div class="cache-map__stage" dir="ltr">
    <svg viewBox="0 0 760 300" role="img" aria-label="A hash map pointing into a doubly linked list ordered from most to least recently used">
      <defs>
        <marker id="cache-map-arrow" viewBox="0 0 10 10" refX="8.5" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
          <path d="M 0 0 L 10 5 L 0 10 z" class="cache-map__arrow" />
        </marker>
      </defs>

      <text class="cache-map__label" x="24" y="26">hash map</text>
      <text class="cache-map__label" x="300" y="26">doubly linked list · lru order</text>

      {buckets.map((bucket, index) => (
        <g
          class="cache-map__bucket"
          data-bucket={bucket.id}
          data-target={bucket.target ?? ''}
          transform={'translate(24 ' + (44 + index * 40) + ')'}
        >
          <rect width="176" height="30" rx="8" />
          <text class="cache-map__bucket-key" x="12" y="19">{bucket.key}</text>
          <text class="cache-map__bucket-ttl" x="164" y="19">{bucket.ttl}</text>
        </g>
      ))}

      <!-- bucket to node routes -->
      <g class="cache-map__routes">
        {buckets.filter((bucket) => bucket.target).map((bucket) => {
          const fromY = 44 + buckets.indexOf(bucket) * 40 + 15;
          const node = nodes.find((entry) => entry.id === bucket.target)!;
          const midX = (200 + node.x - 65) / 2;
          const d = 'M 200 ' + fromY + ' C ' + (midX + 10) + ' ' + fromY + ', ' + (midX - 10) + ' 140, ' + (node.x - 65) + ' 140';
          return (
            <path
              class="cache-map__route"
              data-route={bucket.id}
              d={d}
              marker-end="url(#cache-map-arrow)"
            />
          );
        })}
      </g>

      <!-- linked list nodes -->
      {nodes.map((node) => (
        <g class="cache-map__node" data-node={node.id} data-bucket={node.bucket} transform={'translate(' + (node.x - 65) + ' 111)'}>
          <rect width="130" height="58" rx="12" />
          <text class="cache-map__node-label" x="65" y="26">{node.label}</text>
          <text class="cache-map__node-ttl" x="65" y="43">{node.ttl}</text>
        </g>
      ))}

      <!-- next / prev arrows -->
      <g class="cache-map__links">
        <path d="M 366 140 H 396" marker-end="url(#cache-map-arrow)" />
        <path d="M 404 128 H 374" marker-end="url(#cache-map-arrow)" />
        <path d="M 536 140 H 566" marker-end="url(#cache-map-arrow)" />
        <path d="M 574 128 H 544" marker-end="url(#cache-map-arrow)" />
      </g>

      <text class="cache-map__note" x="300" y="196">head · most recent</text>
      <path class="cache-map__tick" d="M 300 172 V 184" />
      <text class="cache-map__note" x="640" y="196">tail · next to evict</text>
      <path class="cache-map__tick" d="M 640 172 V 184" />

      <g class="cache-map__paths">
        <text class="cache-map__path" x="24" y="238">
          <tspan class="cache-map__path-key">read</tspan>
          <tspan>hash(key) → bucket → node, O(1) → move node to head → return value</tspan>
        </text>
        <text class="cache-map__path" x="24" y="266">
          <tspan class="cache-map__path-key">write</tspan>
          <tspan>new node at head → if bytes exceed the cap, unlink the tail and delete its bucket</tspan>
        </text>
      </g>
    </svg>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-cache-map]').forEach((map) => {
    const buckets = Array.from(map.querySelectorAll<SVGGElement>('[data-bucket]'));
    const nodes = Array.from(map.querySelectorAll<SVGGElement>('[data-node]'));
    const routes = Array.from(map.querySelectorAll<SVGPathElement>('[data-route]'));

    const clear = (): void => {
      buckets.forEach((bucket) => bucket.classList.remove('is-lit'));
      nodes.forEach((node) => node.classList.remove('is-lit'));
      routes.forEach((route) => route.classList.remove('is-lit'));
    };

    const light = (bucketId: string, nodeId: string): void => {
      clear();
      buckets.forEach((bucket) => {
        if (bucket.dataset.bucket === bucketId) bucket.classList.add('is-lit');
      });
      nodes.forEach((node) => {
        if (node.dataset.node === nodeId) node.classList.add('is-lit');
      });
      routes.forEach((route) => {
        if (route.dataset.route === bucketId) route.classList.add('is-lit');
      });
    };

    buckets.forEach((bucket) => {
      const target = bucket.dataset.target ?? '';
      if (!target) return;
      bucket.addEventListener('mouseenter', () => light(bucket.dataset.bucket ?? '', target));
      bucket.addEventListener('mouseleave', clear);
    });

    nodes.forEach((node) => {
      const bucket = node.dataset.bucket ?? '';
      node.addEventListener('mouseenter', () => light(bucket, node.dataset.node ?? ''));
      node.addEventListener('mouseleave', clear);
    });
  });
</script>
