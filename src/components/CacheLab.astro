---
/**
 * A small, honest simulator for the three structures the cache is built from.
 *
 * The markup ships with a seeded state (a, b, c at capacity 4), so the section is readable with
 * JavaScript off. The script seeds the same state and takes over from there. Every label and log
 * line comes from cacheLabCopy, so the widget speaks the language of the page it sits on.
 */
import { cacheLabCopy } from '../data/cacheLab';
import { defaultLang, type Lang } from '../i18n/ui';

interface Props {
  lang?: Lang;
}

const lang = Astro.props.lang ?? defaultLang;
const t = cacheLabCopy[lang];
// keep '<' out of the attribute: JSON.parse on the client turns \u003c back into '<'
const copyAttribute = JSON.stringify(t).replace(/</g, '\\u003c');
---

<section class="lab" data-lab data-copy={copyAttribute} aria-labelledby="lab-title">
  <header class="lab__head">
    <h2 id="lab-title">{t.title}</h2>
    <p class="lab__hint">{t.hint}</p>
  </header>

  <div class="lab__grid">
    <div class="lab__col">
      <p class="lab__panel-title">{t.mapTitle}</p>
      <ul class="lab__map" data-lab-map>
        <li class="lab__row"><span class="lab__key">a</span><span class="lab__arrow">→</span><span class="lab__value">A</span><span class="lab__ttl">{t.noTtl}</span></li>
        <li class="lab__row"><span class="lab__key">b</span><span class="lab__arrow">→</span><span class="lab__value">B</span><span class="lab__ttl">{t.noTtl}</span></li>
        <li class="lab__row"><span class="lab__key">c</span><span class="lab__arrow">→</span><span class="lab__value">C</span><span class="lab__ttl">{t.noTtl}</span></li>
      </ul>
    </div>
    <div class="lab__col">
      <p class="lab__panel-title">{t.lruTitle}</p>
      <div class="lab__lru" data-lab-lru>
        <span class="lab__node lab__node--head">a</span>
        <span class="lab__lru-arrow">→</span>
        <span class="lab__node">b</span>
        <span class="lab__lru-arrow">→</span>
        <span class="lab__node lab__node--tail">c</span>
      </div>
    </div>
  </div>

  <ul class="lab__log" data-lab-log aria-live="polite">
    <li dir="auto">{t.seed}</li>
  </ul>

  <form class="lab__cmd" data-lab-form>
    <span class="lab__ps" aria-hidden="true">&gt;</span>
    <input
      class="lab__input"
      data-lab-input
      type="text"
      autocomplete="off"
      autocapitalize="off"
      spellcheck="false"
      aria-label={t.inputLabel}
      placeholder={t.placeholder}
    />
    <button type="submit" class="lab__run">{t.run}</button>
  </form>

  <div class="lab__quick">
    <button type="button" data-lab-quick="set d">set d</button>
    <button type="button" data-lab-quick="get a">get a</button>
    <button type="button" data-lab-quick="ttl b 3">ttl b 3</button>
    <button type="button" data-lab-quick="del c">del c</button>
    <button type="button" data-lab-quick="sweep">sweep</button>
    <button type="button" data-lab-quick="reset">reset</button>
  </div>
</section>

<script>
  interface Entry {
    key: string;
    value: string;
    ttl: number | null;
    expired: boolean;
  }

  const lab = document.querySelector<HTMLElement>('[data-lab]');
  if (lab) {
    const mapList = lab.querySelector<HTMLElement>('[data-lab-map]');
    const lruList = lab.querySelector<HTMLElement>('[data-lab-lru]');
    const logList = lab.querySelector<HTMLElement>('[data-lab-log]');
    const form = lab.querySelector<HTMLFormElement>('[data-lab-form]');
    const input = lab.querySelector<HTMLInputElement>('[data-lab-input]');

    // the server already spoke this page's language; keep using its words
    const copy = JSON.parse(lab.dataset.copy ?? '{}') as Record<string, string>;
    const fill = (template: string, values: Record<string, string | number>): string =>
      template.replace(/\{(\w+)\}/g, (_match, name: string) => String(values[name] ?? ''));

    const CAPACITY = 4;
    let order: string[] = [];
    let entries = new Map<string, Entry>();
    let log: string[] = [];

    const seed = (): void => {
      order = ['a', 'b', 'c'];
      entries = new Map([
        ['a', { key: 'a', value: 'A', ttl: null, expired: false }],
        ['b', { key: 'b', value: 'B', ttl: null, expired: false }],
        ['c', { key: 'c', value: 'C', ttl: null, expired: false }]
      ]);
      log = [copy.seed];
    };

    const note = (line: string): void => {
      log = [line, ...log].slice(0, 3);
    };

    const remove = (key: string): void => {
      entries.delete(key);
      order = order.filter((item) => item !== key);
    };

    const promote = (key: string): void => {
      order = [key, ...order.filter((item) => item !== key)];
    };

    const render = (): void => {
      if (mapList) {
        mapList.innerHTML = '';
        [...entries.values()]
          .sort((left, right) => left.key.localeCompare(right.key))
          .forEach((entry) => {
            const item = document.createElement('li');
            const ttl = entry.ttl !== null ? fill(copy.ttlShort, { seconds: entry.ttl }) : copy.noTtl;
            item.className = 'lab__row' + (entry.expired ? ' lab__row--expired' : '');
            const cell = (className: string, text: string): HTMLSpanElement => {
              const span = document.createElement('span');
              span.className = className;
              span.textContent = text;
              return span;
            };
            item.append(
              cell('lab__key', entry.key),
              cell('lab__arrow', '→'),
              cell('lab__value', entry.value),
              cell('lab__ttl', ttl)
            );
            mapList.appendChild(item);
          });
        if (entries.size === 0) {
          const item = document.createElement('li');
          item.className = 'lab__row lab__row--empty';
          item.textContent = copy.empty;
          mapList.appendChild(item);
        }
      }

      if (lruList) {
        lruList.innerHTML = '';
        order.forEach((key, index) => {
          if (index > 0) {
            const arrow = document.createElement('span');
            arrow.className = 'lab__lru-arrow';
            arrow.textContent = '→';
            lruList.appendChild(arrow);
          }
          const node = document.createElement('span');
          node.className =
            'lab__node' +
            (index === 0 ? ' lab__node--head' : '') +
            (index === order.length - 1 ? ' lab__node--tail' : '');
          node.textContent = key;
          lruList.appendChild(node);
        });
        if (order.length === 0) {
          lruList.innerHTML = '<span class="lab__node lab__node--head">' + copy.empty + '</span>';
        }
      }

      if (logList) {
        logList.innerHTML = '';
        log.forEach((line) => {
          const item = document.createElement('li');
          item.dir = 'auto';
          item.textContent = line;
          logList.appendChild(item);
        });
      }
    };

    const set = (key: string): void => {
      if (!key) return;
      if (!entries.has(key) && order.length >= CAPACITY) {
        const victim = order[order.length - 1];
        remove(victim);
        note(fill(copy.setEvicted, { key, victim }));
      } else {
        note(fill(copy.setStored, { key }));
      }
      entries.set(key, { key, value: key.toUpperCase(), ttl: null, expired: false });
      promote(key);
    };

    const get = (key: string): void => {
      const entry = entries.get(key);
      if (!entry) {
        note(fill(copy.getMiss, { key }));
        return;
      }
      if (entry.expired) {
        remove(key);
        note(fill(copy.getExpired, { key }));
        return;
      }
      promote(key);
      note(fill(copy.getHit, { key }));
    };

    const ttl = (key: string, seconds: number): void => {
      const entry = entries.get(key);
      if (!entry) {
        note(fill(copy.ttlMissing, { key }));
        return;
      }
      if (!Number.isFinite(seconds)) {
        note(fill(copy.badSeconds, { key }));
        return;
      }
      entry.ttl = Math.max(1, Math.min(9, seconds));
      entry.expired = false;
      note(fill(copy.ttlSet, { key, seconds: entry.ttl }));
    };

    const del = (key: string): void => {
      if (!entries.has(key)) {
        note(fill(copy.delMissing, { key }));
        return;
      }
      remove(key);
      note(fill(copy.delRemoved, { key }));
    };

    const sweep = (): void => {
      const doomed = [...entries.values()].filter((entry) => entry.expired);
      doomed.forEach((entry) => remove(entry.key));
      note(
        doomed.length
          ? fill(copy.sweepRemoved, { keys: doomed.map((entry) => entry.key).join('، ') })
          : copy.sweepNothing
      );
    };

    const run = (raw: string): void => {
      const [command, key, argument] = raw.trim().toLowerCase().split(/\s+/);
      if (['set', 'get', 'del', 'ttl'].includes(command) && !key) {
        note(copy.missingKey);
        render();
        return;
      }
      switch (command) {
        case 'set':
          set(key);
          break;
        case 'get':
          get(key);
          break;
        case 'ttl':
          ttl(key, Number(argument ?? 3));
          break;
        case 'del':
          del(key);
          break;
        case 'sweep':
          sweep();
          break;
        case 'reset':
          seed();
          note(copy.reset);
          break;
        default:
          note(copy.unknown);
      }
      render();
    };

    form?.addEventListener('submit', (event) => {
      event.preventDefault();
      if (!input) return;
      run(input.value);
      input.value = '';
    });

    lab.querySelectorAll<HTMLButtonElement>('[data-lab-quick]').forEach((button) => {
      button.addEventListener('click', () => run(button.dataset.labQuick ?? ''));
    });

    window.setInterval(() => {
      let changed = false;
      entries.forEach((entry) => {
        if (entry.ttl !== null && !entry.expired) {
          entry.ttl -= 1;
          if (entry.ttl <= 0) {
            entry.ttl = 0;
            entry.expired = true;
            changed = true;
            note(fill(copy.expired, { key: entry.key }));
          }
        }
      });
      if (changed) render();
    }, 1000);

    seed();
    render();
  }
</script>