---
import Base from '../../layouts/Base.astro';
import ArchDiagram from '../ArchDiagram.astro';
import CacheLab from '../CacheLab.astro';
import BenchChart from '../BenchChart.astro';
import CacheStructure from '../CacheStructure.astro';
import { marked } from 'marked';
import { render } from 'astro:content';
import { dict, type Lang } from '../../i18n/ui';
import { workSlug, type WorkEntry } from '../../i18n/content';
import { getFlow } from '../../data/flows';
import { getGraph } from '../../data/arch';

interface Props {
  lang: Lang;
  entry: WorkEntry;
}

const { lang, entry } = Astro.props;
const t = dict(lang);
const { Content } = await render(entry);
const slug = workSlug(entry.id);
const flow = getFlow(lang, slug);
const graph = getGraph(slug);

// markers let a case study place a component mid-article
const MARKS: Record<string, string> = { '<!-- chart -->': 'chart', '<!-- structure -->': 'structure' };
const slugify = (value: string): string =>
  value
    .replace(/&[#a-z0-9]+;/gi, '')
    .replace(/<[^>]+>/g, '')
    .toLowerCase()
    .replace(/[^\p{L}\p{N}]+/gu, '-')
    .replace(/^-+|-+$/g, '');

const markedHtml = entry.body
  ? (marked.parse(entry.body, { gfm: true }) as string)
      .replace(/<h2>([\s\S]*?)<\/h2>/g, (_m, text: string) => '<h2 id="' + slugify(text) + '">' + text + '</h2>')
      .replace(/<h3>([\s\S]*?)<\/h3>/g, (_m, text: string) => '<h3 id="' + slugify(text) + '">' + text + '</h3>')
  : '';

const pieces = markedHtml.split(/(<!-- (?:chart|structure) -->)/g).map((piece) => ({
  kind: MARKS[piece] ?? 'html',
  html: piece
}));
const hasMarkers = pieces.some((piece) => piece.kind !== 'html');

---

<Base
  lang={lang}
  title={entry.data.title + ' — ' + t.personName}
  description={entry.data.summary}
>
  <article class="article">
    <p class="post-meta">
      <span>{t.personName} | {entry.data.summary}</span>
    </p>

    <h1>{entry.data.title}</h1>
    <p class="post-lead">{entry.data.lead}</p>

    {flow && graph && (
      <ArchDiagram
        id={'arch-' + lang + '-' + slug}
        flow={flow}
        graph={graph}
        playLabel={t.playFlow}
        pauseLabel={t.pauseFlow}
      />
    )}

    {hasMarkers
      ? pieces.map((piece) =>
          piece.kind === 'chart' ? <BenchChart lang={lang} /> :
          piece.kind === 'structure' ? <CacheStructure lang={lang} /> :
          <div set:html={piece.html} />
        )
      : <Content />}

    {slug === 'smart-cache-engine' && <CacheLab lang={lang} />}
  </article>
</Base>