---
import '../../styles/main-page.css';
import { locales, localesInfo, localePath, defaultLang, type Lang } from '../../i18n/ui';
import { getPortfolio, contactInfo } from '../../data/portfolio';

interface Props {
  lang?: Lang;
}

const lang = Astro.props.lang ?? defaultLang;
const info = localesInfo[lang];
const data = getPortfolio(lang);
const other: Lang = lang === 'en' ? 'ar' : 'en';
const switchHref = localePath(other, '/');

const site = 'https://glgl.me';
const canonical = new URL(localePath(lang, '/'), site).href;
const alternates = locales.map((locale) => ({
  hreflang: localesInfo[locale].htmlLang,
  href: new URL(localePath(locale, '/'), site).href
}));

const expCount = String(data.experience.length).padStart(2, '0');
const projCount = String(data.projects.length).padStart(2, '0');
---

<!doctype html>
<html lang={info.htmlLang} dir={info.dir} data-palette="nile-silt" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{data.meta.title}</title>
    <meta name="description" content={data.meta.description} />
    <meta name="author" content={data.identity.name} />
    <link rel="canonical" href={canonical} />
    {alternates.map((alt) => (
      <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={new URL('/', site).href} />
    <meta name="color-scheme" content="dark light" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={data.meta.title} />
    <meta property="og:description" content={data.meta.description} />
    <meta property="og:image" content={site + '/assets/img/og.png'} />
    <meta property="og:locale" content={info.htmlLang} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={data.meta.title} />
    <meta name="twitter:description" content={data.meta.description} />
    <meta name="twitter:image" content={site + '/assets/img/og.png'} />

    <link rel="icon" type="image/png" sizes="64x64" href="/assets/img/favicon-64.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/img/favicon-180.png" />
    <link rel="preload" href="/assets/fonts/geist-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/assets/fonts/geistmono-latin.woff2" as="font" type="font/woff2" crossorigin />

    <script is:inline>
      try {
        var root = document.documentElement;
        var savedPalette = localStorage.getItem('palette');
        if (savedPalette) root.dataset.palette = savedPalette;
        var savedTheme = localStorage.getItem('main-theme');
        if (savedTheme === 'light' || savedTheme === 'dark') root.dataset.theme = savedTheme;
      } catch (e) {}
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('is-world-entering');
        window.setTimeout(function () {
          document.documentElement.classList.remove('is-world-entering');
        }, 2200);
      }
    </script>

    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Person',
        name: data.identity.name,
        jobTitle: data.meta.jobTitle,
        url: site,
        image: site + contactInfo.avatarUrl,
        email: 'mailto:' + contactInfo.email,
        address: { '@type': 'PostalAddress', addressLocality: 'Cairo', addressCountry: 'EG' },
        sameAs: [contactInfo.githubUrl, contactInfo.linkedinUrl]
      })}
    />
  </head>

  <body>
    <!-- Full-Viewport Interactive WebGL2 Pixel-Art + Bayer Dither Landscape -->
    <canvas class="pixel-landscape-canvas" data-pixel-landscape aria-hidden="true"></canvas>

    <!-- Far-Right Floating Vertical Utility Pill (Frosted + Concave-Fillet Hover Morph) -->
    <aside class="utility-dock" aria-label="controls" data-enter-sea>
      <button
        type="button"
        class="dock-morph-btn"
        data-dock-morph
        data-palette-trigger
        aria-haspopup="listbox"
        aria-expanded="false"
        aria-label={data.controls.paletteLabel}
      >
        <svg class="dock-morph-svg" width="120" height="34" viewBox="0 0 120 34" aria-hidden="true">
          <path class="dock-morph-path" d="" />
        </svg>
        <span class="dock-morph-icon">
          <span class="dock-swatch" aria-hidden="true"></span>
        </span>
        <span class="dock-morph-tip" data-dock-tip>{data.controls.paletteLabel}</span>
      </button>

      <button
        type="button"
        class="dock-morph-btn"
        data-dock-morph
        data-theme-toggle
        data-current="dark"
        data-label-dark={data.controls.themeDark}
        data-label-light={data.controls.themeLight}
        aria-label={data.controls.themeLight}
      >
        <svg class="dock-morph-svg" width="120" height="34" viewBox="0 0 120 34" aria-hidden="true">
          <path class="dock-morph-path" d="" />
        </svg>
        <span class="dock-morph-icon">
          <svg class="theme-icon theme-icon--sun" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
            <circle cx="12" cy="12" r="4.2" fill="none" stroke="currentColor" stroke-width="1.8" />
            <path
              d="M12 2.8v2M12 19.2v2M2.8 12h2M19.2 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M18.7 5.3l-1.4 1.4M6.7 17.3l-1.4 1.4"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
            />
          </svg>
          <svg class="theme-icon theme-icon--moon" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
            <path
              d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linejoin="round"
            />
          </svg>
        </span>
        <span class="dock-morph-tip" data-dock-tip data-theme-tip>{data.controls.themeLight}</span>
      </button>

      <a
        href={switchHref}
        hreflang={localesInfo[other].htmlLang}
        lang={localesInfo[other].htmlLang}
        class="dock-morph-btn"
        data-dock-morph
        aria-label={data.controls.otherLangFull}
      >
        <svg class="dock-morph-svg" width="120" height="34" viewBox="0 0 120 34" aria-hidden="true">
          <path class="dock-morph-path" d="" />
        </svg>
        <span class="dock-morph-icon">{data.controls.otherLangShort}</span>
        <span class="dock-morph-tip" data-dock-tip>{data.controls.otherLangFull}</span>
      </a>
    </aside>

    <!-- Palette Popover -->
    <div class="palette-popover" role="listbox" data-palette-menu data-open="false" aria-label={data.controls.paletteLabel}>
      {data.palettes.map((palette, index) => (
        <button
          type="button"
          role="option"
          class="palette-opt"
          data-palette-option={palette.id}
          aria-selected={index === 0 ? 'true' : 'false'}
        >
          <span class="palette-dot" style={`background:${palette.swatchBg}`}>
            <i style={`background:${palette.swatchAccent}`}></i>
          </span>
          <span>{palette.name}</span>
        </button>
      ))}
    </div>

    <!-- Responsive Viewport Stage (No Header/Footer Chrome Blocking Scene) -->
    <div class="viewport-shell" data-viewport-shell>
      <main class="stage-main">
        <div class="two-zone">
          <!-- Left Column (35%): Compact Identity Rail (No Status Pill) -->
          <section class="identity-col" aria-label="identity">
            <div class="id-head" data-enter-sky>
              <img
                src={contactInfo.avatarUrl}
                alt={data.identity.name}
                class="avatar"
                width="60"
                height="60"
                decoding="async"
              />
              <div class="id-titles">
                <h1 class="id-name">{data.identity.name}</h1>
                <p class="id-role">
                  {data.identity.role}
                  <span class="role-sep" aria-hidden="true">·</span>
                  <a href={localePath(lang, '/about/')} class="role-about-link">{data.controls.aboutLink}</a>
                </p>
              </div>
            </div>

            <p class="bio-primary" data-enter-sea>{data.identity.bioPrimary}</p>
            <p class="bio-secondary" data-enter-sea>{data.identity.bioSecondary}</p>

            <div class="cta-row" data-enter-sea>
              <a
                href={contactInfo.resumeUrl}
                target="_blank"
                rel="noopener"
                class="cta-btn cta-btn--primary"
              >
                <span>{data.controls.resume}</span>
                <span aria-hidden="true">↗</span>
              </a>

              <button
                type="button"
                class="cta-btn cta-btn--secondary"
                data-copy-email={contactInfo.email}
                data-label-default={data.controls.copyEmail}
                data-label-copied={data.controls.copied}
              >
                <span data-copy-label>{data.controls.copyEmail}</span>
              </button>
            </div>

            <!-- Compact 40x40 square icon row with concave-fillet SVG morph hover labels -->
            <nav class="icon-row" aria-label="contact" data-enter-sea>
              <a
                href={contactInfo.resumeUrl}
                target="_blank"
                rel="noopener"
                class="morph-btn morph-btn--accent"
                data-morph-btn
                aria-label={data.controls.resume}
              >
                <svg class="morph-svg" width="110" height="70" viewBox="0 0 110 70" aria-hidden="true">
                  <path class="morph-path" d="" />
                </svg>
                <span class="morph-icon">
                  <svg viewBox="0 0 20 20" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M5.5 2.75h6L15.25 6.5v10.75h-9.75z" />
                    <path d="M11.25 2.75V6.75h4" />
                    <path d="M8 10.75h4.25M8 13.75h3" />
                  </svg>
                </span>
                <span class="morph-tip" data-morph-tip>{data.controls.resume}</span>
              </a>

              <a
                href={'mailto:' + contactInfo.email}
                class="morph-btn"
                data-morph-btn
                aria-label={data.controls.email}
              >
                <svg class="morph-svg" width="110" height="70" viewBox="0 0 110 70" aria-hidden="true">
                  <path class="morph-path" d="" />
                </svg>
                <span class="morph-icon">
                  <svg viewBox="0 0 20 20" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="2.5" y="4.25" width="15" height="11.5" rx="2.5" />
                    <path d="M3.25 5.75 10 10.75l6.75-5" />
                  </svg>
                </span>
                <span class="morph-tip" data-morph-tip>{data.controls.email}</span>
              </a>

              <a
                href={contactInfo.phoneHref}
                class="morph-btn"
                data-morph-btn
                aria-label={data.controls.phone}
              >
                <svg class="morph-svg" width="110" height="70" viewBox="0 0 110 70" aria-hidden="true">
                  <path class="morph-path" d="" />
                </svg>
                <span class="morph-icon">
                  <svg viewBox="0 0 20 20" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M4.5 3.75h3l1.25 3.5-1.75 1.25a9.5 9.5 0 0 0 4.5 4.5l1.25-1.75 3.5 1.25v3a1.5 1.5 0 0 1-1.6 1.5A12.25 12.25 0 0 1 3 5.35a1.5 1.5 0 0 1 1.5-1.6Z" />
                  </svg>
                </span>
                <span class="morph-tip" data-morph-tip>{data.controls.phone}</span>
              </a>

              <a
                href={contactInfo.githubUrl}
                target="_blank"
                rel="noopener"
                class="morph-btn"
                data-morph-btn
                aria-label={data.controls.github}
              >
                <svg class="morph-svg" width="110" height="70" viewBox="0 0 110 70" aria-hidden="true">
                  <path class="morph-path" d="" />
                </svg>
                <span class="morph-icon">
                  <svg viewBox="0 0 16 16" width="14" height="14" fill="currentColor" aria-hidden="true">
                    <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
                  </svg>
                </span>
                <span class="morph-tip" data-morph-tip>{data.controls.github}</span>
              </a>

              <a
                href={contactInfo.linkedinUrl}
                target="_blank"
                rel="noopener"
                class="morph-btn"
                data-morph-btn
                aria-label={data.controls.linkedin}
              >
                <svg class="morph-svg" width="110" height="70" viewBox="0 0 110 70" aria-hidden="true">
                  <path class="morph-path" d="" />
                </svg>
                <span class="morph-icon">
                  <svg viewBox="0 0 16 16" width="14" height="14" fill="currentColor" aria-hidden="true">
                    <path d="M13.6 1H2.4C1.63 1 1 1.63 1 2.4v11.2c0 .77.63 1.4 1.4 1.4h11.2c.77 0 1.4-.63 1.4-1.4V2.4c0-.77-.63-1.4-1.4-1.4ZM5.2 13H3.1V6.3h2.1V13ZM4.15 5.4a1.22 1.22 0 1 1 0-2.44 1.22 1.22 0 0 1 0 2.44ZM13 13h-2.1V9.74c0-.78-.02-1.78-1.08-1.78-1.09 0-1.25.85-1.25 1.72V13H6.47V6.3h2.01v.92h.03c.28-.53.97-1.09 1.99-1.09 2.13 0 2.52 1.4 2.52 3.22V13Z" />
                  </svg>
                </span>
                <span class="morph-tip" data-morph-tip>{data.controls.linkedin}</span>
              </a>
            </nav>
          </section>

          <!-- Right Column (65%): Adaptive Frosted Connected-Tab Panel -->
          <section class="panel-col" aria-label="portfolio" data-enter-sea>
            <div class="panel-unified-bg" data-panel-unified-bg aria-hidden="true"></div>
            <svg class="panel-unified-outline" data-panel-unified-outline focusable="false" aria-hidden="true">
              <path class="panel-unified-stroke" data-panel-unified-stroke />
            </svg>

            <div class="tabs-bar" role="tablist" data-tabs-bar>
              <button type="button" role="tab" class="tab-btn" data-tab="experience" aria-selected="true">
                <span>{data.tabs.experience}</span>
                <span class="tab-count ltr">{expCount}</span>
              </button>

              <button type="button" role="tab" class="tab-btn" data-tab="projects" aria-selected="false">
                <span>{data.tabs.projects}</span>
                <span class="tab-count ltr">{projCount}</span>
              </button>

              <button type="button" role="tab" class="tab-btn" data-tab="stack" aria-selected="false">
                <span>{data.tabs.stack}</span>
              </button>

              <button type="button" role="tab" class="tab-btn" data-tab="education" aria-selected="false">
                <span>{data.tabs.education}</span>
              </button>
            </div>

            <div class="panel-box" data-panel-box>

              <!-- TAB 1: EXPERIENCE -->
              <div class="tab-panel" role="tabpanel" data-panel="experience" data-active="true">
                <div class="master-detail">
                  <div class="drum-rail" data-drum="experience" role="listbox" aria-label={data.tabs.experience}>
                    <div class="drum-stage">
                      {data.experience.map((job, idx) => (
                        <button
                          type="button"
                          role="option"
                          class="drum-item"
                          data-drum-item="experience"
                          data-index={idx}
                          aria-selected={idx === 0 ? 'true' : 'false'}
                        >
                          <span class="drum-num ltr">{job.num}</span>
                          <span class="drum-text">
                            <span class="drum-title">{job.company}</span>
                            <span class="drum-sub">{job.shortRole} · {job.shortPeriod}</span>
                          </span>
                        </button>
                      ))}
                    </div>
                  </div>

                  <div class="inspector-pane" data-inspector="experience">
                    {data.experience.map((job, idx) => (
                      <article class="inspector-entry" data-entry="experience" data-index={idx} data-active={idx === 0 ? 'true' : 'false'}>
                        <div class="inspector-top">
                          <div class="inspector-heading">
                            <div class="inspector-head">
                              <div class="inspector-title-row">
                                <h2 class="inspector-title">{job.company}</h2>
                              </div>
                              <span class="date-pill">{job.period}</span>
                            </div>
                            <p class="inspector-sub">{job.role}</p>
                          </div>

                          <ul class="impact-list">
                            {job.bullets.map((b) => (
                              <li>{b}</li>
                            ))}
                          </ul>
                        </div>

                        <div class="inspector-foot">
                          <ul class="chips">
                            {job.stack.map((tech) => (
                              <li class="chip ltr">{tech}</li>
                            ))}
                          </ul>
                          <span class="wheel-hint">{data.controls.wheelHint}</span>
                        </div>
                      </article>
                    ))}
                  </div>
                </div>
              </div>

              <!-- TAB 2: PROJECTS -->
              <div class="tab-panel" role="tabpanel" data-panel="projects" data-active="false">
                <div class="master-detail">
                  <div class="drum-rail" data-drum="projects" role="listbox" aria-label={data.tabs.projects}>
                    <div class="drum-stage">
                      {data.projects.map((project, idx) => (
                        <button
                          type="button"
                          role="option"
                          class="drum-item"
                          data-drum-item="projects"
                          data-index={idx}
                          aria-selected={idx === 0 ? 'true' : 'false'}
                        >
                          <span class="drum-num ltr">{project.num}</span>
                          <span class="drum-text">
                            <span class="drum-title ltr">{project.name}</span>
                            <span class="drum-sub ltr">{project.shortMeta}</span>
                          </span>
                        </button>
                      ))}
                    </div>
                  </div>

                  <div class="inspector-pane" data-inspector="projects">
                    {data.projects.map((project, idx) => (
                      <article class="inspector-entry" data-entry="projects" data-index={idx} data-active={idx === 0 ? 'true' : 'false'}>
                        <div class="inspector-top">
                          <div class="inspector-heading">
                            <div class="inspector-head">
                              <div class="inspector-title-row">
                                <h2 class="inspector-title ltr">{project.name}</h2>
                                <span class="inspector-year ltr">{project.year}</span>
                              </div>
                              <div class="proj-links">
                                <a href={project.repoUrl} target="_blank" rel="noopener" class="pill-link pill-link--accent">
                                  <span>{data.controls.code}</span>
                                  <span aria-hidden="true">↗</span>
                                </a>
                                <a href={localePath(lang, '/work/' + project.slug + '/')} class="pill-link">
                                  <span>{data.controls.docs}</span>
                                  <span aria-hidden="true">↗</span>
                                </a>
                              </div>
                            </div>
                            <p class="proj-summary">{project.summary}</p>
                          </div>

                          <div class="pipeline-bar">
                            <code class="pipeline-code ltr" title={project.pipeline}>{project.pipeline}</code>
                            <span class="metric-pill ltr">{project.metric}</span>
                          </div>

                          <ul class="impact-list">
                            {project.bullets.map((b) => (
                              <li>{b}</li>
                            ))}
                          </ul>
                        </div>

                        <div class="inspector-foot">
                          <ul class="chips">
                            {project.stack.map((tech) => (
                              <li class="chip chip--tech ltr" data-tech={tech}>{tech}</li>
                            ))}
                          </ul>
                          <span class="wheel-hint">{data.controls.wheelHint}</span>
                        </div>
                      </article>
                    ))}
                  </div>
                </div>
              </div>

              <!-- TAB 3: STACK -->
              <div class="tab-panel" role="tabpanel" data-panel="stack" data-active="false">
                <div class="stack-grid">
                  {data.skills.map((group) => (
                    <div class="stack-card">
                      <div class="stack-card__head">
                        <h2 class="stack-card__label">{group.label}</h2>
                        <span class="stack-card__count ltr">{String(group.items.length).padStart(2, '0')}</span>
                      </div>
                      <ul class="chips">
                        {group.items.map((skill) => (
                          <li class="chip chip--stack ltr" data-tech={skill}>{skill}</li>
                        ))}
                      </ul>
                    </div>
                  ))}
                </div>
              </div>

              <!-- TAB 4: EDUCATION -->
              <div class="tab-panel" role="tabpanel" data-panel="education" data-active="false">
                <div class="edu-view">
                  <div class="inspector-heading">
                    <div class="inspector-head">
                      <div class="inspector-title-row">
                        <h2 class="inspector-title">{data.education.school}</h2>
                      </div>
                      <span class="date-pill ltr">{data.education.period}</span>
                    </div>
                    <p class="inspector-sub">{data.education.degree} · {data.education.location}</p>
                  </div>

                  <div class="stat-strip">
                    {data.education.stats.map((st) => (
                      <div class="stat-cell">
                        <span class="stat-label">{st.label}:</span>
                        <span class="stat-val" dir="auto">{st.value}</span>
                      </div>
                    ))}
                  </div>

                  <ul class="impact-list">
                    {data.education.highlights.map((h) => (
                      <li>{h}</li>
                    ))}
                  </ul>

                  <div class="edu-course-box">
                    <span class="edu-course-title">coursework</span>
                    <ul class="chips">
                      {data.education.courses.map((course) => (
                        <li class="chip">{course}</li>
                      ))}
                    </ul>
                  </div>
                </div>
              </div>
            </div>
          </section>
        </div>
      </main>
    </div>

    <script>
      import { initPixelLandscape, type PaletteId } from '../../scripts/pixelLandscape';
      import { jellyEnter, jellySlideEnter, jellyPulse, createSpringScalar } from '../../scripts/jellyPhysics';

      const root = document.documentElement;
      const isRTL = root.dir === 'rtl';
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // -----------------------------------------------------------------------
      // 1. Initialize WebGL2 Pixel-Art + Bayer Dither Landscape
      // -----------------------------------------------------------------------
      const landscapeCanvas = document.querySelector<HTMLCanvasElement>('[data-pixel-landscape]');
      const viewportShell = document.querySelector<HTMLElement>('[data-viewport-shell]');
      const initialPalette = (root.dataset.palette as PaletteId) || 'nile-silt';
      const initialLight = root.dataset.theme === 'light';

      const landscape = landscapeCanvas
        ? initPixelLandscape(landscapeCanvas, initialPalette, initialLight)
        : null;

      // -----------------------------------------------------------------------
      // 2. Sea & Sky Entrance Orchestration (synchronized with WebGL drop)
      // -----------------------------------------------------------------------
      const utilityDock = document.querySelector<HTMLElement>('.utility-dock');

      const launchWorldEntrance = () => {
        if (reducedMotion) {
          root.classList.remove('is-world-entering');
          return;
        }

        const skyTargets: Array<{ selector: string; delayMs: number }> = [
          { selector: '.id-head[data-enter-sky]', delayMs: 0 }
        ];

        const seaTargets: Array<{ selector: string; fromY: number; delayMs: number; baseTransform?: string }> = [
          { selector: '.bio-primary[data-enter-sea]', fromY: 38, delayMs: 40 },
          { selector: '.bio-secondary[data-enter-sea]', fromY: 42, delayMs: 95 },
          { selector: '.cta-row[data-enter-sea]', fromY: 46, delayMs: 150 },
          { selector: '.icon-row[data-enter-sea]', fromY: 50, delayMs: 205 },
          { selector: '.panel-col[data-enter-sea]', fromY: 48, delayMs: 100 },
          {
            selector: '.utility-dock[data-enter-sea]',
            fromY: 44,
            delayMs: 240,
            baseTransform: window.innerWidth >= 1325 ? 'translate3d(0, -50%, 0)' : ''
          }
        ];

        skyTargets.forEach(({ selector, delayMs }) => {
          const el = document.querySelector<HTMLElement>(selector);
          if (el) {
            jellyEnter(el, {
              fromY: -36,
              delayMs,
              stiffness: 210,
              damping: 16
            });
          }
        });

        seaTargets.forEach(({ selector, fromY, delayMs, baseTransform }) => {
          const el = document.querySelector<HTMLElement>(selector);
          if (el) {
            jellyEnter(el, {
              fromY,
              delayMs,
              stiffness: 200,
              damping: 16,
              baseTransform
            });
          }
        });

        // Each element already holds inline opacity: 0 until its spring begins.
        window.setTimeout(() => {
          root.classList.remove('is-world-entering');
        }, 100);
      };

      if (reducedMotion) {
        root.classList.remove('is-world-entering');
      } else {
        window.setTimeout(launchWorldEntrance, 420);
      }

      // -----------------------------------------------------------------------
      // 3. Unified Frosted Panel + Tab Silhouette (Liquid Jelly Spring)
      // -----------------------------------------------------------------------
      const panelCol = document.querySelector<HTMLElement>('.panel-col');
      const tabsBar = document.querySelector<HTMLElement>('[data-tabs-bar]');
      const panelBox = document.querySelector<HTMLElement>('[data-panel-box]');
      const panelUnifiedBg = document.querySelector<HTMLElement>('[data-panel-unified-bg]');
      const panelUnifiedOutline = document.querySelector<SVGSVGElement>('[data-panel-unified-outline]');
      const panelUnifiedStroke = document.querySelector<SVGPathElement>('[data-panel-unified-stroke]');
      const tabBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-tab]'));
      const tabPanels = Array.from(document.querySelectorAll<HTMLElement>('[data-panel]'));
      const tabOrder = ['experience', 'projects', 'stack', 'education'];
      let activeTab = 'experience';

      const clampNum = (val: number, min: number, max: number) => Math.min(max, Math.max(min, val));

      const buildUnifiedPanelPath = (
        W: number,
        H: number,
        y0: number,
        tabLeft: number,
        tabWidth: number,
        velocity: number,
        inset = 0
      ): string => {
        const xMin = inset;
        const xMax = W - inset;
        const yTop = inset;
        const yBot = H - inset;
        const R = 14;
        const r = Math.min(11, tabWidth * 0.22);

        const maxL = Math.max(xMin + R + 4, xMax - R - 4 - tabWidth);
        const L = clampNum(tabLeft, xMin + R + 4, maxL);
        const Rt = Math.min(xMax - R - 4, L + tabWidth);

        const lean = clampNum(velocity * 0.004, -5, 5);
        const baseS = 14;
        const maxSL = Math.max(4, Math.min(y0 - yTop - r - 1, L - (xMin + R)));
        const maxSR = Math.max(4, Math.min(y0 - yTop - r - 1, xMax - R - Rt));
        const sL = clampNum(baseS + (velocity > 0 ? Math.abs(lean) : -Math.abs(lean) * 0.35), 4, maxSL);
        const sR = clampNum(baseS + (velocity < 0 ? Math.abs(lean) : -Math.abs(lean) * 0.35), 4, maxSR);

        const f = (n: number) => n.toFixed(2);
        return [
          `M ${f(xMin + R)} ${f(y0)}`,
          `L ${f(L - sL)} ${f(y0)}`,
          `Q ${f(L)} ${f(y0)} ${f(L)} ${f(y0 - sL)}`,
          `L ${f(L)} ${f(yTop + r)}`,
          `Q ${f(L)} ${f(yTop)} ${f(L + r)} ${f(yTop)}`,
          `L ${f(Rt - r)} ${f(yTop)}`,
          `Q ${f(Rt)} ${f(yTop)} ${f(Rt)} ${f(yTop + r)}`,
          `L ${f(Rt)} ${f(y0 - sR)}`,
          `Q ${f(Rt)} ${f(y0)} ${f(Rt + sR)} ${f(y0)}`,
          `L ${f(xMax - R)} ${f(y0)}`,
          `Q ${f(xMax)} ${f(y0)} ${f(xMax)} ${f(y0 + R)}`,
          `L ${f(xMax)} ${f(yBot - R)}`,
          `Q ${f(xMax)} ${f(yBot)} ${f(xMax - R)} ${f(yBot)}`,
          `L ${f(xMin + R)} ${f(yBot)}`,
          `Q ${f(xMin)} ${f(yBot)} ${f(xMin)} ${f(yBot - R)}`,
          `L ${f(xMin)} ${f(y0 + R)}`,
          `Q ${f(xMin)} ${f(y0)} ${f(xMin + R)} ${f(y0)}`,
          'Z'
        ].join(' ');
      };

      const applyBridgeTransform = () => {
        if (!panelCol || !tabsBar || !panelBox || !panelUnifiedBg || !panelUnifiedOutline || !panelUnifiedStroke) {
          return;
        }
        const W = panelCol.clientWidth;
        const H = panelCol.clientHeight;
        const y0 = panelBox.offsetTop;
        if (W <= 0 || H <= 0 || y0 <= 0) return;

        const vx = bridgeX.getVelocity();
        const tabWidth = Math.max(28, bridgeW.getValue());
        const tabLeft = bridgeX.getValue() - (tabsBar.scrollLeft || 0);

        const fillPath = buildUnifiedPanelPath(W, H, y0, tabLeft, tabWidth, vx, 0);
        const strokePath = buildUnifiedPanelPath(W, H, y0, tabLeft, tabWidth, vx, 0.5);

        panelUnifiedBg.style.clipPath = `path("${fillPath}")`;
        (panelUnifiedBg.style as CSSStyleDeclaration & { webkitClipPath?: string }).webkitClipPath = `path("${fillPath}")`;
        panelUnifiedOutline.setAttribute('viewBox', `0 0 ${W} ${H}`);
        panelUnifiedStroke.setAttribute('d', strokePath);
      };

      const bridgeX = createSpringScalar({
        initial: 0,
        stiffness: 280,
        damping: 18,
        epsilon: 0.15,
        onUpdate: applyBridgeTransform,
        onRest: applyBridgeTransform
      });

      const bridgeW = createSpringScalar({
        initial: 118,
        stiffness: 280,
        damping: 18,
        epsilon: 0.15,
        onUpdate: applyBridgeTransform,
        onRest: applyBridgeTransform
      });

      const syncTabBridge = (instant = false) => {
        if (!tabsBar) return;
        const activeBtn = tabBtns.find((b) => b.dataset.tab === activeTab) ?? tabBtns[0];
        if (!activeBtn) return;
        const x = activeBtn.offsetLeft;
        const w = activeBtn.offsetWidth;
        if (instant) {
          bridgeX.snap(x);
          bridgeW.snap(w);
          applyBridgeTransform();
        } else {
          bridgeX.setTarget(x);
          bridgeW.setTarget(w);
        }
      };

      const selectTab = (id: string) => {
        if (id === activeTab) return;
        const prevTab = activeTab;
        const prevIdx = tabOrder.indexOf(prevTab);
        const nextIdx = tabOrder.indexOf(id);
        const dir = (nextIdx >= prevIdx ? 1 : -1) * (isRTL ? -1 : 1);
        activeTab = id;

        tabBtns.forEach((b) => {
          const selected = b.dataset.tab === id;
          b.setAttribute('aria-selected', selected ? 'true' : 'false');
          b.tabIndex = selected ? 0 : -1;
        });

        const prevPanel = tabPanels.find((p) => p.dataset.panel === prevTab);
        const nextPanel = tabPanels.find((p) => p.dataset.panel === id);

        tabPanels.forEach((p) => {
          if (p !== prevPanel && p !== nextPanel) {
            delete p.dataset.exiting;
            p.dataset.active = 'false';
          }
        });

        if (prevPanel && !reducedMotion) {
          prevPanel.dataset.exiting = 'true';
          prevPanel.dataset.active = 'false';
          const exitAnim = prevPanel.animate(
            [
              { opacity: 1, transform: 'translate3d(0, 0, 0) scale(1)' },
              { opacity: 0, transform: `translate3d(${-18 * dir}px, 0, 0) scale(0.985)` }
            ],
            { duration: 150, easing: 'cubic-bezier(0.22, 1, 0.36, 1)' }
          );
          exitAnim.onfinish = () => {
            if (prevPanel.dataset.panel !== activeTab) {
              delete prevPanel.dataset.exiting;
            }
          };
        } else if (prevPanel) {
          delete prevPanel.dataset.exiting;
          prevPanel.dataset.active = 'false';
        }

        if (nextPanel) {
          delete nextPanel.dataset.exiting;
          nextPanel.dataset.active = 'true';
          if (!reducedMotion) {
            jellySlideEnter(nextPanel, {
              fromX: 28 * dir,
              stiffness: 290,
              damping: 21,
              stretchFactor: 0.00018
            });
          }
        }

        syncTabBridge(false);

        const activeBtn = tabBtns.find((b) => b.dataset.tab === id);
        activeBtn?.scrollIntoView({
          behavior: reducedMotion ? 'auto' : 'smooth',
          block: 'nearest',
          inline: 'nearest'
        });

        if (panelCol) {
          jellyPulse(panelCol, { vx: -14 * dir, vy: 8, intensity: 0.32 });
        }
        landscape?.triggerWindGust();
      };

      tabBtns.forEach((b, index) => {
        b.tabIndex = b.dataset.tab === activeTab ? 0 : -1;
        b.addEventListener('click', () => {
          if (b.dataset.tab) selectTab(b.dataset.tab);
        });
        b.addEventListener('keydown', (e) => {
          let nextIndex: number | null = null;
          if (e.key === 'ArrowRight') nextIndex = (index + (isRTL ? -1 : 1) + tabBtns.length) % tabBtns.length;
          if (e.key === 'ArrowLeft') nextIndex = (index + (isRTL ? 1 : -1) + tabBtns.length) % tabBtns.length;
          if (e.key === 'Home') nextIndex = 0;
          if (e.key === 'End') nextIndex = tabBtns.length - 1;
          if (nextIndex === null) return;
          e.preventDefault();
          const nextTab = tabBtns[nextIndex];
          if (!nextTab?.dataset.tab) return;
          selectTab(nextTab.dataset.tab);
          nextTab.focus();
        });
      });

      syncTabBridge(true);
      requestAnimationFrame(() => syncTabBridge(true));
      tabsBar?.addEventListener('scroll', applyBridgeTransform, { passive: true });
      if (panelCol && typeof ResizeObserver !== 'undefined') {
        const panelRo = new ResizeObserver(() => syncTabBridge(true));
        panelRo.observe(panelCol);
      }

      // -----------------------------------------------------------------------
      // 4. Static Entry Lists — Wheel, Arrow & Click Selection + Jelly Pulse
      // -----------------------------------------------------------------------
      const drumIndices: Record<string, number> = { experience: 0, projects: 0 };
      const wheelLocks: Record<string, number> = { experience: 0, projects: 0 };

      const setDrumIndex = (group: string, nextIndex: number) => {
        const items = Array.from(document.querySelectorAll<HTMLButtonElement>(`[data-drum-item="${group}"]`));
        const entries = Array.from(document.querySelectorAll<HTMLElement>(`[data-entry="${group}"]`));
        if (!items.length) return;

        const clamped = Math.max(0, Math.min(items.length - 1, nextIndex));
        if (clamped === drumIndices[group]) return;
        const dir = clamped > drumIndices[group] ? 1 : -1;
        drumIndices[group] = clamped;

        items.forEach((item, idx) => {
          item.setAttribute('aria-selected', idx === clamped ? 'true' : 'false');
        });

        entries.forEach((entry, idx) => {
          entry.dataset.active = idx === clamped ? 'true' : 'false';
        });

        const selectedItem = items[clamped];
        const activeEntry = entries[clamped];
        if (selectedItem) {
          jellyPulse(selectedItem, { vy: dir * 18, intensity: 0.5 });
          if (window.innerWidth < 960) {
            selectedItem.scrollIntoView({
              behavior: reducedMotion ? 'auto' : 'smooth',
              block: 'nearest',
              inline: 'nearest'
            });
          }
        }
        if (activeEntry && !reducedMotion) {
          jellyEnter(activeEntry, {
            fromY: 14 * dir,
            stiffness: 320,
            damping: 22,
            stretchFactor: 0.00016
          });
        }
        landscape?.triggerMicroRipple();
      };

      ['experience', 'projects'].forEach((group) => {
        const drumEl = document.querySelector<HTMLElement>(`[data-drum="${group}"]`);
        const items = Array.from(document.querySelectorAll<HTMLButtonElement>(`[data-drum-item="${group}"]`));

        items.forEach((item) => {
          item.addEventListener('click', () => {
            const idx = Number(item.dataset.index ?? 0);
            if (idx === drumIndices[group]) {
              jellyPulse(item, { intensity: 0.35 });
            } else {
              setDrumIndex(group, idx);
            }
          });
        });

        drumEl?.addEventListener(
          'wheel',
          (e) => {
            if (window.innerWidth < 960 || Math.abs(e.deltaY) < 4) return;
            const now = performance.now();
            if (now - wheelLocks[group] < 180) return;
            wheelLocks[group] = now;
            e.preventDefault();
            const dir = e.deltaY > 0 ? 1 : -1;
            const total = items.length;
            setDrumIndex(group, (drumIndices[group] + dir + total) % total);
          },
          { passive: false }
        );

        drumEl?.addEventListener('keydown', (e) => {
          const horizontal = window.innerWidth < 960;
          const previousKey = horizontal ? (isRTL ? 'ArrowRight' : 'ArrowLeft') : 'ArrowUp';
          const nextKey = horizontal ? (isRTL ? 'ArrowLeft' : 'ArrowRight') : 'ArrowDown';
          let nextIndex: number | null = null;
          if (e.key === previousKey) nextIndex = (drumIndices[group] - 1 + items.length) % items.length;
          if (e.key === nextKey) nextIndex = (drumIndices[group] + 1) % items.length;
          if (e.key === 'Home') nextIndex = 0;
          if (e.key === 'End') nextIndex = items.length - 1;
          if (nextIndex === null) return;
          e.preventDefault();
          setDrumIndex(group, nextIndex);
          items[nextIndex]?.focus();
        });
      });

      // -----------------------------------------------------------------------
      // 5. Fluid Concave-Fillet SVG Morph — Contact Icons & Vertical Dock
      // -----------------------------------------------------------------------
      const buildDownMorph = (cx: number, tw: number, p: number): string => {
        const t = Math.max(0, Math.min(1.06, p));
        const lerp = (a: number, b: number) => +(a + (b - a) * t).toFixed(2);
        const bw = 20, r = 11, s = 1.65, rt = 9.5, st = 1.4, f = 8;
        const yNeck = 36, yTop = 44, yBot = 70, ry0 = 29;
        const rx = cx + bw, lx = cx - bw;

        const rEdgeY = lerp(ry0, yNeck);
        const rFilletCp1Y = lerp(ry0, yNeck + 5);
        const rFilletCp2X = lerp(rx, rx + f - 5);
        const rFilletEndX = lerp(rx, rx + f);
        const rTipTopY = lerp(ry0, yTop);
        const rTipRunX = lerp(rx, cx + tw - rt);
        const rTipCornerCp1X = lerp(rx, cx + tw - st);
        const rTipOuterX = lerp(rx, cx + tw);
        const rTipCornerCp2Y = lerp(ry0, yTop + st);
        const rTipCornerEndY = lerp(ry0, yTop + rt);
        const rTipSideEndY = lerp(ry0, yBot - rt);

        const botCornerCp1Y = lerp(40 - s, yBot - st);
        const botCornerCp2X = lerp(rx - s, cx + tw - st);
        const botY = lerp(40, yBot);
        const botCornerEndX = lerp(rx - r, cx + tw - rt);

        const lBotEdgeX = lerp(lx + r, cx - tw + rt);
        const lBotCornerCp1X = lerp(lx + s, cx - tw + st);
        const lTipOuterX = lerp(lx, cx - tw);
        const lTipCornerCp2X = lerp(lx, cx - tw + st);
        const lTipRunX = lerp(lx, cx - tw + rt);
        const lFilletStartX = lerp(lx, lx - f);
        const lFilletCp1X = lerp(lx, lx - f + 5);

        return [
          `M ${cx - bw + r} 0`,
          `L ${cx + bw - r} 0`,
          `C ${rx - s} 0 ${rx} ${s} ${rx} ${r}`,
          `L ${rx} ${rEdgeY}`,
          `C ${rx} ${rFilletCp1Y} ${rFilletCp2X} ${rTipTopY} ${rFilletEndX} ${rTipTopY}`,
          `L ${rTipRunX} ${rTipTopY}`,
          `C ${rTipCornerCp1X} ${rTipTopY} ${rTipOuterX} ${rTipCornerCp2Y} ${rTipOuterX} ${rTipCornerEndY}`,
          `L ${rTipOuterX} ${rTipSideEndY}`,
          `C ${rTipOuterX} ${botCornerCp1Y} ${botCornerCp2X} ${botY} ${botCornerEndX} ${botY}`,
          `L ${lBotEdgeX} ${botY}`,
          `C ${lBotCornerCp1X} ${botY} ${lTipOuterX} ${botCornerCp1Y} ${lTipOuterX} ${rTipSideEndY}`,
          `L ${lTipOuterX} ${rTipCornerEndY}`,
          `C ${lTipOuterX} ${rTipCornerCp2Y} ${lTipCornerCp2X} ${rTipTopY} ${lTipRunX} ${rTipTopY}`,
          `L ${lFilletStartX} ${rTipTopY}`,
          `C ${lFilletCp1X} ${rTipTopY} ${lx} ${rFilletCp1Y} ${lx} ${rEdgeY}`,
          `L ${lx} ${r}`,
          `C ${lx} ${s} ${lx + s} 0 ${cx - bw + r} 0`,
          'Z'
        ].join(' ');
      };

      const buildSideMorph = (svgW: number, labelW: number, p: number): string => {
        const t = Math.max(0, Math.min(1.06, p));
        const lerp = (a: number, b: number) => +(a + (b - a) * t).toFixed(2);
        const H = 34, r = 10, s = 1.5;
        const bx2 = svgW, bx1 = svgW - 34;
        const tipTop = 4, tipBot = 30, rt = 8.5, st = 1.3;
        const neckX = bx1 + 2, f = 6;
        const leftX = Math.max(2, bx1 - 6 - labelW);

        const topFilletX = lerp(bx1 + r, neckX);
        const topFilletEndX = lerp(bx1 + r, bx1 - f);
        const topTipY = lerp(0, tipTop);
        const tipLeftX = lerp(bx1, leftX);
        const tipRunX = lerp(bx1 + r, leftX + rt);
        const botTipY = lerp(H, tipBot);
        const tipCornerTopEndY = lerp(r, tipTop + rt);
        const tipCornerBotStartY = lerp(H - r, tipBot - rt);

        return [
          `M ${bx2 - r} 0`,
          `C ${bx2 - s} 0 ${bx2} ${s} ${bx2} ${r}`,
          `L ${bx2} ${H - r}`,
          `C ${bx2} ${H - s} ${bx2 - s} ${H} ${bx2 - r} ${H}`,
          `L ${topFilletX} ${H}`,
          `C ${lerp(bx1 + s, bx1 - 1)} ${H} ${lerp(bx1, bx1 - 1)} ${botTipY} ${topFilletEndX} ${botTipY}`,
          `L ${tipRunX} ${botTipY}`,
          `C ${lerp(bx1 + s, leftX + st)} ${botTipY} ${tipLeftX} ${lerp(H - s, tipBot - st)} ${tipLeftX} ${tipCornerBotStartY}`,
          `L ${tipLeftX} ${tipCornerTopEndY}`,
          `C ${tipLeftX} ${lerp(s, tipTop + st)} ${lerp(bx1 + s, leftX + st)} ${topTipY} ${tipRunX} ${topTipY}`,
          `L ${topFilletEndX} ${topTipY}`,
          `C ${lerp(bx1, bx1 - 1)} ${topTipY} ${lerp(bx1 + s, bx1 - 1)} 0 ${topFilletX} 0`,
          'Z'
        ].join(' ');
      };

      const morphRemeasure: Array<() => void> = [];
      document.querySelectorAll<HTMLElement>('[data-morph-btn]').forEach((btn) => {
        const svg = btn.querySelector<SVGSVGElement>('.morph-svg');
        const path = btn.querySelector<SVGPathElement>('.morph-path');
        const tip = btn.querySelector<HTMLElement>('[data-morph-tip]');
        if (!svg || !path || !tip) return;
        let cx = 55, tw = 40;

        const renderMorph = (val: number) => {
          const t = Math.max(0, Math.min(1.06, val));
          path.setAttribute('d', buildDownMorph(cx, tw, t));
          tip.style.transform = `translateX(-50%) translateY(${((t - 1) * 4).toFixed(2)}px)`;
        };

        const spring = createSpringScalar({
          initial: 0,
          stiffness: 255,
          damping: 15,
          onUpdate: renderMorph
        });

        const measure = () => {
          const w = tip.offsetWidth || tip.getBoundingClientRect().width;
          tw = Math.max(38, Math.ceil(w / 2) + 2);
          const sw = Math.max(106, Math.ceil(tw * 2) + 8);
          cx = sw / 2;
          svg.setAttribute('width', String(sw));
          svg.setAttribute('viewBox', `0 0 ${sw} 70`);
          renderMorph(spring.getValue());
        };

        measure();
        morphRemeasure.push(measure);
        btn.addEventListener('pointerenter', () => {
          measure();
          spring.setTarget(1);
          jellyPulse(btn, { vy: 22, intensity: 0.45 });
        });
        btn.addEventListener('pointerleave', () => spring.setTarget(0));
        btn.addEventListener('focus', () => {
          measure();
          spring.setTarget(1);
        });
        btn.addEventListener('blur', () => spring.setTarget(0));
        btn.addEventListener('click', () => {
          jellyPulse(btn, { vy: 26, intensity: 0.72 });
        });
      });

      const dockMorphRemeasure: Array<() => void> = [];
      document.querySelectorAll<HTMLElement>('[data-dock-morph]').forEach((btn) => {
        const svg = btn.querySelector<SVGSVGElement>('.dock-morph-svg');
        const path = btn.querySelector<SVGPathElement>('.dock-morph-path');
        const tip = btn.querySelector<HTMLElement>('[data-dock-tip]');
        if (!svg || !path || !tip) return;
        let svgW = 120, labelW = 64;

        const renderDockMorph = (val: number) => {
          const t = Math.max(0, Math.min(1.06, val));
          path.setAttribute('d', buildSideMorph(svgW, labelW, t));
          if (t > 0.03) btn.dataset.morphActive = 'true';
          else delete btn.dataset.morphActive;
          const tipOffset = isRTL ? (t - 1) * 5 : (1 - t) * 5;
          tip.style.transform = `translateY(-50%) translateX(${tipOffset.toFixed(2)}px)`;
        };

        const spring = createSpringScalar({
          initial: 0,
          stiffness: 255,
          damping: 15,
          onUpdate: renderDockMorph
        });

        const measure = () => {
          const w = tip.offsetWidth || tip.getBoundingClientRect().width;
          labelW = Math.max(46, Math.ceil(w) + 2);
          svgW = Math.max(108, 46 + labelW);
          svg.setAttribute('width', String(svgW));
          svg.setAttribute('viewBox', `0 0 ${svgW} 34`);
          renderDockMorph(spring.getValue());
        };

        measure();
        dockMorphRemeasure.push(measure);
        btn.addEventListener('pointerenter', () => {
          measure();
          spring.setTarget(1);
          jellyPulse(btn, { vx: isRTL ? 20 : -20, intensity: 0.45 });
        });
        btn.addEventListener('pointerleave', () => spring.setTarget(0));
        btn.addEventListener('focus', () => {
          measure();
          spring.setTarget(1);
        });
        btn.addEventListener('blur', () => spring.setTarget(0));
        btn.addEventListener('click', () => {
          jellyPulse(btn, { vx: isRTL ? 24 : -24, intensity: 0.72 });
        });
      });

      if (document.fonts?.ready) {
        document.fonts.ready.then(() => {
          syncTabBridge(true);
          morphRemeasure.forEach((fn) => fn());
          dockMorphRemeasure.forEach((fn) => fn());
        });
      }

      window.addEventListener('resize', () => {
        syncTabBridge(true);
        morphRemeasure.forEach((fn) => fn());
        dockMorphRemeasure.forEach((fn) => fn());
        if (utilityDock && !root.classList.contains('is-world-entering')) {
          utilityDock.style.transform = window.innerWidth >= 1325 ? 'translate3d(0, -50%, 0)' : '';
        }
      });

      // -----------------------------------------------------------------------
      // 6. Theme, Palette, Popover Jelly Spring & Interactive Micro-Pulses
      // -----------------------------------------------------------------------
      const paletteTrigger = document.querySelector<HTMLButtonElement>('[data-palette-trigger]');
      const paletteMenu = document.querySelector<HTMLElement>('[data-palette-menu]');
      const paletteOpts = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-palette-option]'));

      const renderPopoverSpring = (val: number, vel: number) => {
        if (!paletteMenu) return;
        const opacity = Math.max(0, Math.min(1, val));
        const isDesktop = window.innerWidth >= 1325;
        const baseScale = 0.9 + 0.1 * val;
        const stretch = Math.max(0.92, Math.min(1.08, 1 + vel * 0.006));
        const sy = Math.max(0.86, Math.min(1.08, baseScale * stretch));
        const sx = Math.max(0.86, Math.min(1.08, baseScale / Math.sqrt(stretch)));
        const yPrefix = isDesktop
          ? 'translateY(-50%)'
          : `translateY(${((1 - val) * -8).toFixed(2)}px)`;

        paletteMenu.style.opacity = opacity.toFixed(3);
        paletteMenu.style.transform = `${yPrefix} scale(${sx.toFixed(4)}, ${sy.toFixed(4)})`;
      };

      const popoverSpring = createSpringScalar({
        initial: 0,
        stiffness: 300,
        damping: 18,
        onUpdate: renderPopoverSpring,
        onRest: () => {
          if (!paletteMenu) return;
          const open = paletteMenu.dataset.open === 'true';
          const isDesktop = window.innerWidth >= 1325;
          paletteMenu.style.opacity = open ? '1' : '0';
          paletteMenu.style.transform = open
            ? (isDesktop ? 'translateY(-50%)' : '')
            : (isDesktop ? 'translateY(-50%) scale(0.9)' : 'translateY(-8px) scale(0.9)');
        }
      });

      window.addEventListener('resize', () => {
        popoverSpring.snap(paletteMenu?.dataset.open === 'true' ? 1 : 0);
      });

      const setPaletteMenu = (open: boolean) => {
        if (!paletteMenu || !paletteTrigger) return;
        paletteMenu.dataset.open = open ? 'true' : 'false';
        paletteTrigger.setAttribute('aria-expanded', open ? 'true' : 'false');
        popoverSpring.setTarget(open ? 1 : 0);
      };

      const applyPalette = (id: string, animate = true) => {
        const match = paletteOpts.find((o) => o.dataset.paletteOption === id) ?? paletteOpts[0];
        if (!match) return;
        const chosen = (match.dataset.paletteOption ?? 'nile-silt') as PaletteId;
        root.dataset.palette = chosen;
        try { localStorage.setItem('palette', chosen); } catch {}
        paletteOpts.forEach((o) => o.setAttribute('aria-selected', o === match ? 'true' : 'false'));
        landscape?.setPalette(chosen, !animate);
      };

      applyPalette(root.dataset.palette ?? 'nile-silt', false);

      paletteTrigger?.addEventListener('click', (e) => {
        e.stopPropagation();
        setPaletteMenu(paletteMenu?.dataset.open !== 'true');
      });

      paletteOpts.forEach((opt) => {
        opt.addEventListener('pointerenter', () => {
          jellyPulse(opt, { vx: isRTL ? -10 : 10, intensity: 0.25 });
        });
        opt.addEventListener('click', () => {
          jellyPulse(opt, { intensity: 0.55 });
          if (opt.dataset.paletteOption) applyPalette(opt.dataset.paletteOption, true);
          setPaletteMenu(false);
        });
      });

      document.querySelectorAll<HTMLElement>('.cta-btn').forEach((btn) => {
        btn.addEventListener('pointerenter', () => jellyPulse(btn, { vy: -8, intensity: 0.32 }));
        btn.addEventListener('click', () => jellyPulse(btn, { vy: 14, intensity: 0.65 }));
      });

      document.querySelectorAll<HTMLElement>('.pill-link').forEach((link) => {
        link.addEventListener('pointerenter', () => jellyPulse(link, { vy: -6, intensity: 0.3 }));
        link.addEventListener('click', () => jellyPulse(link, { vy: 12, intensity: 0.6 }));
      });

      const themeBtn = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
      const themeTip = document.querySelector<HTMLElement>('[data-theme-tip]');
      const applyTheme = (mode: string, animate = true) => {
        const next = mode === 'light' ? 'light' : 'dark';
        root.dataset.theme = next;
        try { localStorage.setItem('main-theme', next); } catch {}
        if (themeBtn) {
          themeBtn.dataset.current = next;
          const nextLabel = next === 'dark'
            ? themeBtn.dataset.labelLight ?? 'light'
            : themeBtn.dataset.labelDark ?? 'dark';
          themeBtn.setAttribute('aria-label', nextLabel);
          if (themeTip) themeTip.textContent = nextLabel;
          dockMorphRemeasure.forEach((fn) => fn());
        }
        landscape?.setTheme(next === 'light', !animate);
      };

      applyTheme(root.dataset.theme ?? 'dark', false);
      themeBtn?.addEventListener('click', () => applyTheme(root.dataset.theme === 'dark' ? 'light' : 'dark', true));

      document.addEventListener('click', (e) => {
        const target = e.target as HTMLElement | null;
        if (
          paletteMenu && paletteTrigger &&
          !paletteMenu.contains(target as Node) &&
          !paletteTrigger.contains(target as Node)
        ) {
          setPaletteMenu(false);
        }

        // Background landscape clicks (only on empty sky/sea outside the UI cards & dock)
        if (landscape && target && !target.closest('.two-zone, .utility-dock, .palette-popover')) {
          const action = landscape.handleBackgroundClick(e.clientX, e.clientY);
          if (action === 'toggle-theme') {
            applyTheme(root.dataset.theme === 'dark' ? 'light' : 'dark', true);
          }
        }
      });

      // Cursor pointer hint when hovering directly over the moon or sun in open sky
      window.addEventListener(
        'pointermove',
        (e) => {
          if (!landscape || !viewportShell) return;
          const target = e.target as HTMLElement | null;
          const onUi = !!target?.closest('.two-zone, .utility-dock, .palette-popover');
          viewportShell.classList.toggle('is-celestial-hover', !onUi && landscape.isOverCelestial(e.clientX, e.clientY));
        },
        { passive: true }
      );

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') setPaletteMenu(false);
      });

      // Copy email CTA
      const copyBtn = document.querySelector<HTMLButtonElement>('[data-copy-email]');
      if (copyBtn) {
        const labelEl = copyBtn.querySelector<HTMLElement>('[data-copy-label]');
        let timer: number | undefined;
        copyBtn.addEventListener('click', async () => {
          const email = copyBtn.dataset.copyEmail ?? '';
          try {
            await navigator.clipboard.writeText(email);
          } catch {
            const area = document.createElement('textarea');
            area.value = email;
            area.style.position = 'fixed';
            area.style.opacity = '0';
            document.body.appendChild(area);
            area.select();
            document.execCommand('copy');
            area.remove();
          }
          copyBtn.classList.add('is-copied');
          if (labelEl) labelEl.textContent = copyBtn.dataset.labelCopied ?? 'copied';
          window.clearTimeout(timer);
          timer = window.setTimeout(() => {
            copyBtn.classList.remove('is-copied');
            if (labelEl) labelEl.textContent = copyBtn.dataset.labelDefault ?? 'copy email';
          }, 1800);
        });
      }
    </script>

    <style>
      .role-sep {
        margin-inline: 0.28rem;
        opacity: 0.65;
      }

      .role-about-link {
        color: var(--body);
        border-bottom: 1px solid var(--panel-border);
        transition: color 140ms ease, border-color 140ms ease;
      }

      .role-about-link:hover {
        color: var(--accent);
        border-bottom-color: var(--accent-border);
      }
    </style>
  </body>
</html>
