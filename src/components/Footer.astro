---
import { dict, defaultLang, type Lang } from '../i18n/ui';

interface Props {
  lang?: Lang;
}

const lang = Astro.props.lang ?? defaultLang;
const t = dict(lang);
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div>
    {t.personName} (<a href="https://github.com/AhmedAbdelgelel" target="_blank" rel="noopener">@AhmedAbdelgelel</a>)
  </div>
  <div>
    <a href="/assets/cv/AhmedAbdelgelel.pdf" target="_blank" rel="noopener">{t.resume}</a>
    <span> · {year}</span>
  </div>
</footer>
