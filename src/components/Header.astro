---
import { dict, localePath, localesInfo, stripLocale, defaultLang, type Lang } from '../i18n/ui';

interface Props {
  lang?: Lang;
  /** Where the language switch should land, when the matching page does not exist (404). */
  switchPath?: string;
}

const lang = Astro.props.lang ?? defaultLang;
const t = dict(lang);
const path = stripLocale(Astro.url.pathname);
const home = path === '/' || path === '/index.html';
const other: Lang = lang === 'en' ? 'ar' : 'en';
const switchHref = Astro.props.switchPath
  ? localePath(other, Astro.props.switchPath)
  : localePath(other, path === '/' ? '/' : path);
const aboutPath = localePath(lang, '/about/');
---

<header class="site-header">
  <span class="logo">
    {home ? (
      <span class="cursor-default pr-2">{t.personName}</span>
    ) : (
      <a href={localePath(lang, '/')} class="logo--link">{t.personName}</a>
    )}
  </span>

  <nav class="site-nav">
    <a href={localePath(lang, '/')} class="nav-hide-sm nav-work"><span>{t.navWork}</span></a>
    <a href={aboutPath}><span>{t.navAbout}</span></a>
    <a href="mailto:ahmed4bdelgelel@gmail.com" class="nav-hide-sm"><span>{t.navContact}</span></a>
    <a href="https://github.com/AhmedAbdelgelel" target="_blank" rel="noopener" class="nav-github">
      <span>
        <svg viewBox="0 0 16 16" width="12" height="12" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/></svg>
        <span>{t.navGithub}</span>
      </span>
    </a>
    <a
      href={switchHref}
      hreflang={localesInfo[other].htmlLang}
      lang={localesInfo[other].htmlLang}
      class="nav-lang"
      title={t.otherLanguage}
      aria-label={t.otherLanguage}
    >
      <span><span class="nav-lang__full">{t.otherLanguage}</span><span class="nav-lang__short" aria-hidden="true">{t.otherLanguageShort}</span></span>
    </a>
    <button
      class="theme"
      type="button"
      data-theme-btn
      data-mode="system"
      data-label-system={t.themeSystem}
      data-label-light={t.themeLight}
      data-label-dark={t.themeDark}
      aria-label={t.themeLabel}
      title={t.themeLabel}
    >
      <svg class="theme__icon theme__icon--auto" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><circle cx="12" cy="12" r="8.5" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M12 3.5v17" stroke="currentColor" stroke-width="1.6"/><path d="M12 3.5a8.5 8.5 0 0 1 0 17z" fill="currentColor"/></svg>
      <svg class="theme__icon theme__icon--light" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><circle cx="12" cy="12" r="4.2" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M12 2.8v2M12 19.2v2M2.8 12h2M19.2 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M18.7 5.3l-1.4 1.4M6.7 17.3l-1.4 1.4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
      <svg class="theme__icon theme__icon--dark" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
    </button>
  </nav>
</header>

<script>
  const button = document.querySelector<HTMLButtonElement>('[data-theme-btn]');
  if (button) {
    const order = ['system', 'light', 'dark'] as const;
    type Mode = (typeof order)[number];

    const stored = (): Mode => {
      try {
        const saved = localStorage.getItem('theme');
        if (saved === 'light' || saved === 'dark') return saved;
      } catch (error) {}
      return 'system';
    };

    const label = (mode: Mode): string =>
      mode === 'light'
        ? button.dataset.labelLight ?? 'Light'
        : mode === 'dark'
          ? button.dataset.labelDark ?? 'Dark'
          : button.dataset.labelSystem ?? 'System';

    const apply = (mode: Mode): void => {
      if (mode === 'system') document.documentElement.removeAttribute('data-theme');
      else document.documentElement.dataset.theme = mode;
      try {
        if (mode === 'system') localStorage.removeItem('theme');
        else localStorage.setItem('theme', mode);
      } catch (error) {}
      button.dataset.mode = mode;
      button.setAttribute('aria-label', label(mode));
      button.title = label(mode);
    };

    button.addEventListener('click', () => {
      const current = (button.dataset.mode as Mode) ?? 'system';
      apply(order[(order.indexOf(current) + 1) % order.length]);
    });

    apply(stored());
  }
</script>