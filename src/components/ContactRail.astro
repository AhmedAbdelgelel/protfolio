---
import { dict, defaultLang, type Lang } from '../i18n/ui';

interface Section {
  id: string;
  label: string;
}

interface Props {
  lang?: Lang;
  sections?: Section[];
}

const lang = Astro.props.lang ?? defaultLang;
const t = dict(lang);
const sections = Astro.props.sections ?? [];

const contacts = [
  { label: t.email, href: 'mailto:ahmed4bdelgelel@gmail.com', note: 'ahmed4bdelgelel@gmail.com' },
  { label: 'GitHub', href: 'https://github.com/AhmedAbdelgelel', note: '@AhmedAbdelgelel', external: true },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/ahmed-abdelgelel-6aa523283/', note: 'in/ahmed-abdelgelel', external: true },
  { label: t.resume, href: '/assets/cv/AhmedAbdelgelel.pdf', note: 'PDF', external: true }
];
---

<aside class="rail" aria-label={t.onThisPage}>
  {sections.length > 0 && (
    <div class="rail__group">
      <p class="rail__label">{t.onThisPage}</p>
      <ul class="rail__list">
        {sections.map((section) => (
          <li><a href={'#' + section.id}>{section.label}</a></li>
        ))}
      </ul>
    </div>
  )}

  <div class="rail__group">
    <p class="rail__label">{t.contact}</p>
    <ul class="rail__list">
      {contacts.map((contact) => (
        <li>
          <a
            href={contact.href}
            target={contact.external ? '_blank' : undefined}
            rel={contact.external ? 'noopener' : undefined}
            title={contact.note}
          >
            {contact.label}
            {contact.external && <span class="rail__arrow" aria-hidden="true">↗</span>}
          </a>
        </li>
      ))}
    </ul>
  </div>
</aside>
