---
/**
 * Interactive architecture map for a case study.
 *
 * The SVG is rendered on the server, so the diagram exists without JavaScript. The script adds
 * the step machine: click a node (or use the controls) and the map highlights what that stage
 * touches, while a request pulse travels the last edge. Steps come from flows.ts, geometry from
 * arch.ts, so both languages share one drawing.
 */
import type { Flow } from '../data/flows';
import type { ArchGraph } from '../data/arch';

interface Props {
  id: string;
  flow: Flow;
  graph: ArchGraph;
  playLabel: string;
  pauseLabel: string;
}

const { id, flow, graph, playLabel, pauseLabel } = Astro.props;
const titleId = id + '-title';
const markerId = id + '-arrow';

const NODE_H = 52;
const nodes = new Map(graph.nodes.map((node) => [node.id, { ...node, w: node.w ?? 120, h: NODE_H }]));

interface Point { x: number; y: number }
const anchor = (node: { x: number; y: number; w: number; h: number }, side: 'l' | 'r' | 't' | 'b'): Point => {
  if (side === 'l') return { x: node.x - node.w / 2, y: node.y };
  if (side === 'r') return { x: node.x + node.w / 2, y: node.y };
  if (side === 't') return { x: node.x, y: node.y - node.h / 2 };
  return { x: node.x, y: node.y + node.h / 2 };
};

const path = (from: Point, to: Point, horizontal: boolean): string => {
  if (horizontal) {
    const bend = Math.max(28, Math.abs(to.x - from.x) * 0.45);
    return 'M ' + from.x + ' ' + from.y + ' C ' + (from.x + bend) + ' ' + from.y + ', ' + (to.x - bend) + ' ' + to.y + ', ' + to.x + ' ' + to.y;
  }
  const bend = Math.max(24, Math.abs(to.y - from.y) * 0.5);
  return 'M ' + from.x + ' ' + from.y + ' C ' + from.x + ' ' + (from.y + bend) + ', ' + to.x + ' ' + (to.y - bend) + ', ' + to.x + ' ' + to.y;
};

const edges = graph.edges.map((edge) => {
  const source = nodes.get(edge.from);
  const target = nodes.get(edge.to);
  if (!source || !target) return null;

  const dx = target.x - source.x;
  const dy = target.y - source.y;
  let fromSide: 'l' | 'r' | 't' | 'b' = 'r';
  let toSide: 'l' | 'r' | 't' | 'b' = 'l';
  let horizontal = true;

  if (Math.abs(dy) > Math.abs(dx)) {
    horizontal = false;
    fromSide = dy > 0 ? 'b' : 't';
    toSide = dy > 0 ? 't' : 'b';
  } else if (dx < 0) {
    fromSide = 'l';
    toSide = 'r';
  }

  const from = anchor(source, fromSide);
  const to = anchor(target, toSide);
  const midX = (from.x + to.x) / 2;
  const midY = (from.y + to.y) / 2;

  return {
    ...edge,
    d: path(from, to, horizontal),
    labelX: horizontal ? midX : midX + 10,
    labelY: horizontal ? midY - 8 : midY
  };
});

const stepNodes = flow.steps.map((_, index) => graph.stepNodes[index] ?? graph.stepNodes[graph.stepNodes.length - 1] ?? '');
const positions = graph.stepNodes.map((nodeId) => {
  const node = nodes.get(nodeId);
  return node ? { x: node.x, y: node.y } : { x: 0, y: 0 };
});
---

<section
  class="arch"
  data-arch
  data-id={id}
  data-play-label={playLabel}
  data-pause-label={pauseLabel}
  aria-labelledby={titleId}
>
  <header class="arch__head">
    <h2 id={titleId}>{flow.title}</h2>
    <p class="arch__hint">{flow.hint}</p>
  </header>

  <div class="arch__stage" dir="ltr">
    <svg
      viewBox={'0 0 ' + graph.width + ' ' + graph.height}
      role="img"
      aria-label={flow.title}
    >
      <defs>
        <marker id={markerId} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
          <path d="M 0 0 L 10 5 L 0 10 z" class="arch__head-arrow" />
        </marker>
      </defs>

      <g class="arch__edges">
        {edges.map((edge) => edge && (
          <g class="arch__edge" data-from={edge.from} data-to={edge.to}>
            <path d={edge.d} class:list={{ 'arch__edge-path': true, 'is-dashed': edge.dashed }} marker-end={'url(#' + markerId + ')'} />
            {edge.label && (
              <text class="arch__edge-label" x={edge.labelX} y={edge.labelY}>{edge.label}</text>
            )}
          </g>
        ))}
      </g>

      <g class="arch__nodes">
        {graph.nodes.map((node) => {
          const width = node.w ?? 120;
          return (
            <g class="arch__node" data-node={node.id} transform={'translate(' + (node.x - width / 2) + ' ' + (node.y - NODE_H / 2) + ')'}>
              <rect class:list={{ 'arch__node-box': true, 'is-store': node.kind === 'store', 'is-external': node.kind === 'external' }} width={width} height={NODE_H} rx="9" />
              <text class="arch__node-label" x={width / 2} y={node.sub ? 22 : 30}>{node.label}</text>
              {node.sub && <text class="arch__node-sub" x={width / 2} y={37}>{node.sub}</text>}
            </g>
          );
        })}
      </g>

      <circle class="arch__pulse" data-pulse r="4" cx="0" cy="0" opacity="0" />
    </svg>
  </div>

  <div class="arch__bar" dir="ltr">
    <button type="button" class="arch__btn" data-arch-prev aria-label="Previous step">←</button>
    <button type="button" class="arch__play" data-arch-play>
      <span class="arch__play-icon" aria-hidden="true">▶</span>
      <span data-arch-play-label>{playLabel}</span>
    </button>
    <button type="button" class="arch__btn" data-arch-next aria-label="Next step">→</button>
    <span class="arch__count" data-arch-count>01 / {String(flow.steps.length).padStart(2, '0')}</span>
  </div>

  <div class="arch__panels">
    {flow.steps.map((step, index) => (
      <article class="arch__panel" data-panel={index} id={id + '-panel-' + index}>
        <h3>
          {step.title}
          {step.metric && <span class="arch__metric">{step.metric}</span>}
        </h3>
        <p>{step.body}</p>
        {step.notes && (
          <ul class="arch__notes">
            {step.notes.map((note) => <li>{note}</li>)}
          </ul>
        )}
      </article>
    ))}
  </div>

  <script type="application/json" data-arch-data set:html={JSON.stringify({ stepNodes, positions })} />
</section>

<script>
  import { animate } from 'motion/mini';

  interface ArchData {
    stepNodes: string[];
    positions: Array<{ x: number; y: number }>;
  }

  document.querySelectorAll<HTMLElement>('[data-arch]').forEach((section) => {
    const dataEl = section.querySelector<HTMLScriptElement>('[data-arch-data]');
    if (!dataEl?.textContent) return;
    const data = JSON.parse(dataEl.textContent) as ArchData;

    const sectionId = section.dataset.id ?? '';
    const nodes = Array.from(section.querySelectorAll<SVGGElement>('[data-node]'));
    const edges = Array.from(section.querySelectorAll<SVGGElement>('.arch__edge'));
    const panels = Array.from(section.querySelectorAll<HTMLElement>('[data-panel]'));
    const pulse = section.querySelector<SVGCircleElement>('[data-pulse]');
    const count = section.querySelector<HTMLElement>('[data-arch-count]');
    const playText = section.querySelector<HTMLElement>('[data-arch-play-label]');
    const playLabel = section.dataset.playLabel ?? 'Play';
    const pauseLabel = section.dataset.pauseLabel ?? 'Pause';
    const playButton = section.querySelector<HTMLButtonElement>('[data-arch-play]');

    if (!nodes.length || !panels.length) return;
    section.classList.add('is-interactive');

    let current = 0;
    let playing = false;
    let timer: number | undefined;

    const pad = (value: number): string => String(value).padStart(2, '0');

    const highlight = (index: number): void => {
      const activeNode = data.stepNodes[index];
      const previous = data.stepNodes[index - 1];

      nodes.forEach((node) => {
        const isActive = node.dataset.node === activeNode;
        node.classList.toggle('is-active', isActive);
        node.classList.toggle('is-dim', !isActive && !playing);
      });

      edges.forEach((edge) => {
        const from = edge.dataset.from;
        const to = edge.dataset.to;
        const onPath = from === previous && to === activeNode;
        const touches = from === activeNode || to === activeNode;
        edge.classList.toggle('is-path', onPath);
        edge.classList.toggle('is-touch', touches && !onPath);
      });

      panels.forEach((panel, panelIndex) => {
        panel.classList.toggle('is-active', panelIndex === index);
      });

      if (count) count.textContent = pad(index + 1) + ' / ' + pad(panels.length);

      if (pulse) {
        const from = data.positions[index - 1];
        const to = data.positions[index];
        if (to) {
          if (from && playing) {
            pulse.setAttribute('cx', String(from.x));
            pulse.setAttribute('cy', String(from.y));
            animate(0, 1, {
              duration: 0.55,
              ease: 'easeInOut',
              onUpdate: (t: number) => {
                pulse.setAttribute('cx', String(from.x + (to.x - from.x) * t));
                pulse.setAttribute('cy', String(from.y + (to.y - from.y) * t));
              },
              onComplete: () => pulse.setAttribute('opacity', '0')
            });
          } else {
            pulse.setAttribute('cx', String(to.x));
            pulse.setAttribute('cy', String(to.y));
            pulse.setAttribute('opacity', '0');
          }
        }
      }
    };

    const select = (index: number, fromPlay = false): void => {
      current = ((index % panels.length) + panels.length) % panels.length;
      highlight(current);
      if (!fromPlay && playing) stop();
    };

    const stop = (): void => {
      playing = false;
      window.clearTimeout(timer);
      if (playButton) playButton.classList.remove('is-playing');
      if (playText) playText.textContent = playLabel;
      nodes.forEach((node) => node.classList.remove('is-dim'));
    };

    const play = (): void => {
      if (playing) {
        stop();
        return;
      }
      playing = true;
      if (playButton) playButton.classList.add('is-playing');
      if (playText) playText.textContent = pauseLabel;
      current = 0;
      highlight(0);

      const tick = (): void => {
        if (!playing) return;
        if (current >= panels.length - 1) {
          timer = window.setTimeout(() => {
            const pulseEl = pulse;
            if (pulseEl) pulseEl.setAttribute('opacity', '0');
            stop();
          }, 1500);
          return;
        }
        current += 1;
        highlight(current);
        timer = window.setTimeout(tick, 1500);
      };

      timer = window.setTimeout(tick, 1000);
    };

    section.querySelector('[data-arch-prev]')?.addEventListener('click', () => select(current - 1));
    section.querySelector('[data-arch-next]')?.addEventListener('click', () => select(current + 1));
    playButton?.addEventListener('click', play);

    nodes.forEach((node) => {
      node.addEventListener('click', () => {
        const index = data.stepNodes.indexOf(node.dataset.node ?? '');
        if (index >= 0) {
          stop();
          select(index);
        }
      });
    });

    section.addEventListener('keydown', (event) => {
      const key = (event as KeyboardEvent).key;
      if (key === 'ArrowRight' || key === 'ArrowDown') {
        event.preventDefault();
        select(current + 1);
      } else if (key === 'ArrowLeft' || key === 'ArrowUp') {
        event.preventDefault();
        select(current - 1);
      }
    });

    select(0);
  });
</script>
