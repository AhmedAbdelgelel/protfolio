---
import Base from '../layouts/Base.astro';
import { readFileSync } from 'node:fs';
import { marked } from 'marked';

// The About page is README.md: photo, bio, experience, stack, contact.
const source = readFileSync('README.md', 'utf8');

// optional: the first HTML comment in README.md can carry the page metadata
const metaMatch = source.match(/<!--[\s\S]*?meta:\s*(\{[\s\S]*?\})[\s\S]*?-->/);
const meta = metaMatch
  ? (JSON.parse(metaMatch[1]) as { title?: string; description?: string })
  : null;
const body = source.replace(/<!--[\s\S]*?-->/g, '').replace(/^#\s+.*$/m, '');
let html = marked.parse(body, { gfm: true }) as string;

// give every h2 a stable id so the page can be linked to a section
const slug = (value: string): string =>
  value
    .replace(/&[#a-z0-9]+;/gi, '')
    .replace(/<[^>]+>/g, '')
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-+|-+$/g, '');

html = html.replace(/<h2>([\s\S]*?)<\/h2>/g, (_match, text: string) => {
  return '<h2 id="' + slug(text) + '">' + text + '</h2>';
});
---

<Base
  title={meta?.title ?? 'Ahmed Abdelgelel'}
  description={meta?.description ?? 'Forward-deployed engineer in Cairo: Node.js and TypeScript backends, LLM gateways, and agentic systems.'}
>
  <article class="article article--about">
    <h1>About</h1>
    <div set:html={html} />
  </article>
</Base>