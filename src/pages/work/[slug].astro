---
import WorkPage from '../../components/pages/WorkPage.astro';
import { workEntries, workSlug } from '../../i18n/content';

export async function getStaticPaths() {
  const entries = await workEntries('en');
  return entries.map((entry) => ({ params: { slug: workSlug(entry.id) }, props: { entry } }));
}

const { entry } = Astro.props;
---

<WorkPage lang="en" entry={entry} />
