---
import WorkPage from '../../../components/pages/WorkPage.astro';
import { workEntries, workSlug } from '../../../i18n/content';
import { locales, defaultLang, type Lang } from '../../../i18n/ui';

export async function getStaticPaths() {
  const langs = locales.filter((lang) => lang !== defaultLang);
  const paths = [];
  for (const lang of langs) {
    for (const entry of await workEntries(lang)) {
      paths.push({ params: { lang, slug: workSlug(entry.id) }, props: { entry } });
    }
  }
  return paths;
}

const lang = Astro.params.lang as Lang;
const { entry } = Astro.props;
---

<WorkPage lang={lang} entry={entry} />
